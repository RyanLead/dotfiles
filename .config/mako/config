sort=-time
layer=overlay
anchor=top-right
margin=10
padding=10
width=350
height=110

font=JetBrainsMono Nerd Font 11
border-size=2
border-radius=8
icons=1
max-icon-size=48

default-timeout=5000
ignore-timeout=1

background-color=#282a36
text-color=#f8f8f2
border-color=#bd93f9
progress-color=over #44475a

[urgency=low]
border-color=#6272a4
progress-color=over #6272a4

[urgency=normal]
border-color=#bd93f9
progress-color=over #bd93f9

[urgency=critical]
border-color=#ff5555
text-color=#ff5555
default-timeout=0
progress-color=over #ff5555

[mode=do-not-disturb]
invisible=1
