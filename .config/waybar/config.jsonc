{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/updates", "cpu", "memory", "temperature", "network", "pulseaudio"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 6
        },
        "format-icons": {
            "active":  "●",
            "default": "○",
            "urgent":  "◉"
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": " {used:0.1f}G",
        "interval": 5
    },

    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 Offline",
        "tooltip-format": "{ifname}: {ipaddr}\n{essid} ({signalStrength}%)\n↓{bandwidthDownBits} ↑{bandwidthUpBits}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "custom/updates": {
       "exec": "checkupdates 2>/dev/null | wc -l",
       "interval": 3600,
       "format": "  {}",
       "on-click": "alacritty -e bash -c 'paru -Syu; echo; read -p \"Press enter to close...\"'",
       "tooltip": false
    },

    "tray": {
        "spacing": 8
    }
}
